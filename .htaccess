Options -Indexes
DirectoryIndex index.html index.htm

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Serve existing files normally
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Pretty URLs: /foo -> foo.html  (only if foo.html exists)
  RewriteCond %{REQUEST_URI} ^/([^/]+)/?$ 
  RewriteCond %{DOCUMENT_ROOT}/%1.html -f
  RewriteRule ^ %1.html [L]

  # 3. If no file and no pretty-URL html exists → send to custom 404
  RewriteRule ^ _not-found.html [L]

</IfModule>

# 4. Custom error page (for direct 404 requests)
ErrorDocument 404 /_not-found.html
